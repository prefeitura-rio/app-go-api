# Configurações da Aplicação
APP_ENV=development
PORT=8081
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DB_SSL_MODE=disable
DB_TIMEZONE=UTC

# Connection Pool Settings (Performance Optimization)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5
DB_CONN_MAX_IDLE_TIME=2

# Configurações do Servidor
SERVER_REQUEST_TIMEOUT=30

# Configurações de JWT
JWT_SECRET=
JWT_EXPIRATION=24h

# Configurações do Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# Configurações do Swagger
SWAGGER_HOST=

# Configurações da API RMI (para validação de CNPJs/CNAEs)
RMI_BASE_URL=

# Configurações da API Data Relay (para envio de emails)
DATA_RELAY_BASE_URL=
DATA_RELAY_API_KEY=

# Configurações do Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Connection Pool Settings (Performance Optimization)
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# Configurações de Tracing OpenTelemetry
TRACING_ENABLED=false
TRACING_ENDPOINT=localhost:4317
TRACING_SERVICE_NAME=app-go-api
TRACING_SERVICE_VERSION=v1.0.0

# Configurações do Worker de Sincronização de Órgãos
ORGAO_SYNC_ENABLED=true
ORGAO_SYNC_INTERVAL=15m
ORGAO_SYNC_STALE_THRESHOLD=168h
ORGAO_SYNC_BATCH_SIZE=50
ORGAO_SYNC_MAX_RETRIES=3

RUN_MIGRATIONS=true